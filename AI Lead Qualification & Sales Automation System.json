    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output[0].content[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nreturn [{\n  json: {\n    score: parsed.score,\n    numeric_score: parsed.numeric_score,\n    reason: parsed.reason,\n    follow_up_email: parsed.follow_up_email\n  }\n}];"
      },
