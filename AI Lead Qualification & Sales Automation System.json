        "responses": {
          "values": [
            {
              "content": "=You are a lead qualification assistant. Analyze this lead and respond in JSON only, no extra text AND Sign off with \"Best, Asmit\" — not \"[Your Name]\":\n\nName: {{ $('On form submission').item.json['Full Name?'] }}\nCompany: {{ $('On form submission').item.json['Company'] }}\nBudget: {{ $('On form submission').item.json['Budget'] }}\nMessage: {{ $('On form submission').item.json['What are you looking for?'] }}\n\nRespond with exactly this JSON structure:\n{\n  \"score\": \"Hot\" or \"Warm\" or \"Cold\",\n  \"numeric_score\": a number from 1-10,\n  \"reason\": \"one sentence why\",\n  \"follow_up_email\": \"a personalized 3-4 sentence follow up email to this lead addressing their specific need\"\n}\n\nScoring guide:\n- $2000+ budget + urgent need = 8-10\n- $500-$2000 + clear need = 5-7\n- Under $500 + vague need = 1-4"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
