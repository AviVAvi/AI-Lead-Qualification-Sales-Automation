        "jsCode": "const now = new Date();\nconst fortyEightHours = 48 * 60 * 60 * 1000;\n\nreturn items.filter(item => {\n  const score = item.json['Score'];\n  const followUpSent = item.json['Follow Up Sent'];\n  const timestamp = new Date(item.json['Timestamp']);\n  const elapsed = now - timestamp;\n\n  return (\n    (score === 'Hot' || score === 'Warm') &&\n    followUpSent !== 'Yes' &&\n    elapsed >= fortyEightHours\n  );\n});"
